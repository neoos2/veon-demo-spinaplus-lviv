---
import FutureLink from "./FutureLink.astro";
import { address, email, futureNote, hours, phone, socials } from "./content";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const future = ["Про центр", "Команда", "Блог", "Центри мережі", "Політика конфіденційності", "Публічний договір"];
---
<footer data-rec="SMM-R001" class="footer">
  <div class="container">
    <div class="footer__top">
      <a class="footer__logo" href="#top" aria-label="Spina+ на початок сторінки"><img src={`${base}images/logo.svg`} width="140" height="38" alt="Spina+" /></a>
      <ul class="footer__contacts">
        <li>{address}</li>
        <li>{hours}</li>
        <li class="footer__tel"><a class="link tabular" href={phone.href} data-rec="R-001" data-call-target>{phone.label}</a></li>
        <li><a class="link" href={`mailto:${email}`}>{email}</a></li>
      </ul>
    </div>
    <div class="footer__mid">
      <ul class="footer__future">
        {future.map((label) => <li><FutureLink note={futureNote}>{label}</FutureLink></li>)}
      </ul>
      <ul class="footer__social">
        {socials.map((s) => <li><a class="link" href={s.href} target="_blank" rel="noopener">{s.name}</a></li>)}
      </ul>
    </div>
    <p class="footer__caution">Є протипоказання. План занять визначає фахівець після огляду.</p>
  </div>
</footer>

<style>
  .footer { padding-block: var(--sp-64) var(--sp-40); font-size: var(--text-caption); }
  .footer__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-16) var(--sp-40); }
  .footer__logo { display: block; width: 140px; flex-shrink: 0; }
  .footer__contacts { display: flex; flex-wrap: wrap; gap: var(--sp-8) var(--sp-24); }
  .footer__mid { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-16) var(--sp-40); margin-top: var(--sp-24); }
  .footer__future { display: flex; flex-wrap: wrap; gap: var(--sp-8) var(--sp-24); }
  .footer__future li:nth-last-child(-n+2) :global(.future-link__note) { left: auto; right: 0; }
  .footer__social { display: flex; gap: var(--sp-16); }
  .footer__caution { margin-top: var(--sp-24); color: var(--color-muted); }
  @media (max-width: 719px) {
    .footer__top, .footer__mid { flex-direction: column; align-items: flex-start; }
    .footer__contacts, .footer__future { flex-direction: column; }
    /* Phone: the contacts block right above already carries the call. */
    .footer__tel { display: none; }
    .footer__future li:nth-last-child(-n+2) :global(.future-link__note) { left: 0; right: auto; }
  }
</style>
