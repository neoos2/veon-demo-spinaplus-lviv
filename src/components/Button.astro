---
// Single CTA style for the page. Tone follows the surface: "light" (cream or blue) and "dark" sections invert the fill.
interface Props {
  href: string;
  variant?: "primary" | "outline";
  tone?: "light" | "dark";
  icon?: "phone" | "message";
  block?: boolean;
  class?: string;
  rec?: string;
  external?: boolean;
  callTarget?: boolean;
}
const { href, variant = "primary", tone = "light", icon, block = false, class: cls, rec, external = false, callTarget = false } = Astro.props;
---
<a href={href} class:list={["btn", `btn--${variant}`, `btn--${tone}`, { "btn--block": block }, cls]} data-rec={rec} data-call-target={callTarget ? "" : undefined} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>
  {icon === "phone" && (
    <svg class="btn__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.2 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7A2 2 0 0 1 22 16.9z" /></svg>
  )}
  {icon === "message" && (
    <svg class="btn__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12a8.5 8.5 0 0 1-12.5 7.5L3 21l1.5-5.5A8.5 8.5 0 1 1 21 12z" /></svg>
  )}
  <slot />
</a>

<style>
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-8); min-height: 52px; padding: 0 var(--sp-24); border-radius: var(--radius-btn); border: 2px solid transparent; font: 600 var(--text-body)/1.1 var(--font-body); text-decoration: none; white-space: nowrap; cursor: pointer; transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out), transform var(--dur-micro) var(--ease-out); }
  .btn:active { transform: translateY(1px); }
  .btn__icon { flex-shrink: 0; }
  .btn--block { display: flex; width: 100%; }
  .btn--primary.btn--light { background: var(--color-text); color: var(--color-bg); }
  .btn--primary.btn--light:hover { background: var(--color-text-hover); }
  .btn--primary.btn--dark { background: var(--color-bg); color: var(--color-text); }
  .btn--primary.btn--dark:hover { background: var(--color-panel); }
  .btn--outline.btn--light { border-color: var(--color-text); color: var(--color-text); }
  .btn--outline.btn--light:hover { background: var(--color-text); color: var(--color-bg); }
  .btn--outline.btn--dark { border-color: var(--color-bg); color: var(--color-bg); }
  .btn--outline.btn--dark:hover { background: var(--color-bg); color: var(--color-text); }
  .btn--dark:focus-visible { outline-color: var(--color-bg); }
  .btn[aria-disabled="true"] { opacity: .55; cursor: not-allowed; }
  .btn[aria-disabled="true"]:active { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .btn:active { transform: none; }
  }
</style>
