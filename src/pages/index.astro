---
import Base from "../layouts/Base.astro";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Conditions from "../components/Conditions.astro";
import FirstVisit from "../components/FirstVisit.astro";
import Method from "../components/Method.astro";
import Prices from "../components/Prices.astro";
import Proof from "../components/Proof.astro";
import Contacts from "../components/Contacts.astro";
import Footer from "../components/Footer.astro";
import BottomBar from "../components/BottomBar.astro";
import firaCyrillic from "../assets/fonts/fira-sans-extra-condensed-cyrillic-700-normal.woff2?url";

const title = "Кінезіотерапія у Львові, вул. Стрийська, 45 | Spina+";
const description = "Центр кінезіотерапії та реабілітації Spina+ у Львові. Консультація з пробним заняттям 499 грн. Вул. Стрийська, 45, ТОЦ «Fabrik». Тел. 063 215 23 21.";
---
<Base lang="uk" title={title} description={description}>
  <Fragment slot="head">
    <link rel="icon" href="data:," />
    <link rel="preload" href={firaCyrillic} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <Header slot="header" />
  <Hero />
  <Conditions />
  <FirstVisit />
  <Method />
  <Prices />
  <Proof />
  <Contacts />
  <Fragment slot="footer">
    <Footer />
    <BottomBar />
  </Fragment>
</Base>
